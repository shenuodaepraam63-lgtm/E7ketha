# Public Supabase settings (Vite exposes only the VITE_* values to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only settings
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Use the Supavisor transaction/session pooler URL for Vercel, when available.
SUPABASE_POOLER_URL=postgresql://postgres.thovexnrxstiayltstem:URL_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=${SUPABASE_DB_URL}
SUPABASE_ADMIN_EMAILS=admin@example.com
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# The frontend build maps the public values into VITE_* automatically in vite.config.ts.
