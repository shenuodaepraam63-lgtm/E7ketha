{
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?resource=seo&path=/"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?resource=sitemap"
    },
    {
      "source": "/sitemap/(.*).xml",
      "destination": "/api?resource=$1"
    },
    {
      "source": "/books/:slug",
      "destination": "/api?resource=seo&path=/books/:slug"
    },
    {
      "source": "/novel/:slug",
      "destination": "/api?resource=seo&path=/novel/:slug"
    },
    {
      "source": "/novels/:slug",
      "destination": "/api?resource=seo&path=/novels/:slug"
    },
    {
      "source": "/books/:slug/quotes",
      "destination": "/index.html"
    },
    {
      "source": "/authors/:slug",
      "destination": "/api?resource=seo&path=/authors/:slug"
    },
    {
      "source": "/authors/:slug/quotes",
      "destination": "/index.html"
    },
    {
      "source": "/series/:slug",
      "destination": "/api?resource=seo&path=/series/:slug"
    },
    {
      "source": "/genres/:slug",
      "destination": "/api?resource=seo&path=/genres/:slug"
    },
    {
      "source": "/quotes/categories",
      "destination": "/index.html"
    },
    {
      "source": "/quotes/category/:slug",
      "destination": "/api?resource=seo&path=/quotes/category/:slug"
    },
    {
      "source": "/quotes/:id",
      "destination": "/api?resource=seo&path=/quotes/:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
