{
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/public/**"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api?resource=seo&path=%2F" },
    { "src": "^/sitemap\\.xml$", "dest": "/api?resource=sitemap" },
    { "src": "^/sitemap/(.*)\\.xml$", "dest": "/api?resource=$1" },
    { "src": "^/(books|novel|novels)/([^/]+)$", "dest": "/api?resource=seo&path=/$1/$2" },
    { "src": "^/authors/([^/]+)$", "dest": "/api?resource=seo&path=/authors/$1" },
    { "src": "^/genres/([^/]+)$", "dest": "/api?resource=seo&path=/genres/$1" },
    { "src": "^/series/([^/]+)$", "dest": "/api?resource=seo&path=/series/$1" },
    { "src": "^/quotes/([0-9]+)$", "dest": "/api?resource=seo&path=/quotes/$1" },
    { "src": "^/quotes/category/(.*)", "dest": "/api?resource=seo&path=/quotes/category/$1" },
    { "handle": "filesystem" },
    { "src": "^/api/(.*)$", "dest": "/api" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
